{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "root": false,
  "extends": ["./biome-base.json"],
  "overrides": [
    {
      "includes": [
        "src/**/*.tsx",
        "src/**/*.jsx",
        "!src/**/__tests__/**",
        "!src/**/__fixtures__/**",
        "!src/**/fixtures/**",
        "!src/**/*.test.tsx",
        "!src/**/*.test.jsx",
        "!src/**/*.spec.tsx",
        "!src/**/*.spec.jsx",
        "!src/test/**",
        "!src/components/AppPickerPreview.tsx",
        "!src/components/ConflictDialogPreview.tsx",
        "!src/components/DialogPreviewLayout.tsx",
        "!src/components/DoneEditingWindowPreview.tsx",
        "!src/components/LargeFileWarningPreview.tsx",
        "!src/components/PreferencesPreview.tsx",
        "!src/components/PreviewHome.tsx",
        "!src/components/PreviewIndexLink.tsx",
        "!src/components/PreviewLocalizationControls.tsx",
        "!src/components/RecoveryDialogPreview.tsx"
      ],
      "plugins": ["../frontend/no-hardcoded-ui-text.grit"]
    }
  ]
}
