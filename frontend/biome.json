{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "root": false,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@mui/material": {
                "importNames": [
                  "Chip"
                ],
                "message": "Use CompactBadge to enforce the 18-character badge-label limit."
              },
              "@mui/material/Chip": "Use CompactBadge to enforce the 18-character badge-label limit."
            }
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/**/__tests__/**",
        "src/test/**"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off",
            "noPlaywrightMissingAwait": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/CompactBadge.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "es5"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
