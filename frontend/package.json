{
  "name": "sambee-frontend",
  "version": "2.0.10",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:pdfjs-assets": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "npm run prepare:pdfjs-assets && vite",
    "start": "npm run prepare:pdfjs-assets && vite",
    "postinstall": "node scripts/patch-react-transition-group.mjs && npm run prepare:pdfjs-assets",
    "build": "npm run prepare:pdfjs-assets && tsc && vite build",
    "preview": "vite preview",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=2",
    "test:stable": "node scripts/run-tests-stable.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:debug": "playwright test --project=chromium --headed --debug",
    "test:e2e:install": "playwright install chromium firefox",
    "test:changed": "vitest run --changed",
    "test:watch:changed": "vitest --changed"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.1.2",
    "@react-spring/web": "^10.1.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@use-gesture/react": "^10.3.1",
    "axios": "1.20.0",
    "codemirror": "^6.0.2",
    "codemirror-markdown-tables": "^1.0.1",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "react-photo-view": "^1.2.7",
    "react-router-dom": "^7.18.4",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "swiper": "^14.3.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "overrides": {
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.0",
    "jsdom": "^30.1.1",
    "msw": "^3.0.0",
    "playwright": "^1.59.1",
    "typescript": "^7.0.2",
    "vite": "8.3.1",
    "vitest": "^5.0.0"
  }
}
