{
  "name": "sambee-frontend",
  "version": "2.0.24",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:pdfjs-assets": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "npm run prepare:pdfjs-assets && vite",
    "start": "npm run prepare:pdfjs-assets && vite",
    "preinstall": "node scripts/dependency-state.mjs --clear",
    "postinstall": "node scripts/patch-react-transition-group.mjs && npm run prepare:pdfjs-assets && node scripts/dependency-state.mjs --write",
    "check:dependencies": "node scripts/dependency-state.mjs --check",
    "check:biome": "node scripts/dependency-state.mjs --check-biome",
    "typecheck": "tsc -b --noEmit",
    "build": "npm run typecheck && npm run prepare:pdfjs-assets && vite build",
    "preview": "vite preview",
    "prelint": "npm run check:dependencies && npm run check:biome",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "test": "vitest run",
    "test:ci": "node scripts/run-tests-ci.mjs",
    "test:stable": "node scripts/run-tests-stable.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:browser:ci": "node scripts/run-browser-ci.mjs",
    "test:e2e:debug": "playwright test --project=chromium --headed --debug",
    "test:e2e:install": "playwright install chromium firefox",
    "test:changed": "vitest run --changed",
    "test:watch:changed": "vitest --changed"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@lezer/highlight": "^1.2.5",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.1.2",
    "@react-spring/web": "^10.1.2",
    "@tanstack/react-virtual": "^3.14.22",
    "@use-gesture/react": "^10.3.1",
    "axios": "1.20.0",
    "codemirror": "^6.0.2",
    "codemirror-markdown-tables": "^1.0.1",
    "i18next": "^26.5.7",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.5",
    "react-markdown": "^10.1.0",
    "react-pdf": "^11.0.0",
    "react-photo-view": "^1.2.7",
    "react-router-dom": "^7.18.4",
    "rehype-slug": "6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "11.1.2",
    "swiper": "^14.3.0",
    "unified": "^11.0.5",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "overrides": {
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "playwright": "^1.59.1",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.0"
  }
}
