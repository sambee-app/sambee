#!/bin/bash
# Wrapper script to start backend only if inside devcontainer

if [ -f "/.dockerenv" ] || [ -n "$REMOTE_CONTAINERS" ] || [ -n "$CODESPACES" ]; then
    # We're inside a container
    cd /workspace/backend

    # Kill any existing uvicorn processes and clean up port
    echo "🔍 Checking for existing backend processes..."
    BACKEND_PATTERN="uvicorn.*app.main:app|/workspace/scripts/run-backend-dev.py"
    mapfile -t BACKEND_PIDS < <(pgrep -f "$BACKEND_PATTERN")
    if [ "${#BACKEND_PIDS[@]}" -gt 0 ]; then
        echo "⚠️  Found existing uvicorn process. Stopping it..."
        kill -TERM "${BACKEND_PIDS[@]}"
        sleep 2
        # Force kill if still running
        mapfile -t BACKEND_PIDS < <(pgrep -f "$BACKEND_PATTERN")
        if [ "${#BACKEND_PIDS[@]}" -gt 0 ]; then
            kill -KILL "${BACKEND_PIDS[@]}"
            sleep 1
        fi
        echo "✅ Cleaned up existing processes"
    fi

    # Check if port 8000 is in use and wait for it to be free
    MAX_WAIT=10
    WAITED=0
    while lsof -i :8000 >/dev/null 2>&1; do
        if [ $WAITED -ge $MAX_WAIT ]; then
            echo "❌ Port 8000 still in use after ${MAX_WAIT}s. Attempting to free it..."
            fuser -k 8000/tcp 2>/dev/null || true
            sleep 1
            break
        fi
        echo "⏳ Waiting for port 8000 to be free... (${WAITED}s)"
        sleep 1
        WAITED=$((WAITED + 1))
    done

    # Ensure config.toml file exists
    source /workspace/scripts/ensure-env
    ensure_config_file /workspace/config.toml

    BACKEND_PYTHON="/workspace/backend/.venv/bin/python"
    if ! "$BACKEND_PYTHON" -c "import uvicorn" &> /dev/null; then
        echo "⚠️  Backend dependencies not installed. Installing..."
        /workspace/scripts/setup-backend-venv
        echo "✅ Backend dependencies installed"
    fi

    # Export PYTHONPATH for uvicorn's reload subprocess.
    export PYTHONPATH="${PYTHONPATH:+${PYTHONPATH}:}/workspace/backend"

    "$BACKEND_PYTHON" /workspace/scripts/run-backend-dev.py
else
    echo "⚠️  Not in a devcontainer. Skipping backend start."
    echo "Please reopen in container: Ctrl+Shift+P → 'Dev Containers: Reopen in Container'"
    exit 0
fi
