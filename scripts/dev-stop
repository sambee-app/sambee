#!/bin/bash

echo "🛑 Stopping Sambee development servers..."

# Stop backend
mapfile -t BACKEND_PIDS < <(pgrep -f "uvicorn.*app.main:app|/workspace/scripts/run-backend-dev.py")
if [ "${#BACKEND_PIDS[@]}" -gt 0 ]; then
    echo "Stopping backend server..."
    kill -TERM "${BACKEND_PIDS[@]}"
    echo "✅ Backend stopped"
else
    echo "⚠️  Backend server is not running"
fi

# Stop frontend
if pgrep -f "vite" > /dev/null; then
    echo "Stopping frontend server..."
    pkill -f "vite"
    echo "✅ Frontend stopped"
else
    echo "⚠️  Frontend server is not running"
fi

# Stop website
/workspace/scripts/stop-website

echo ""
echo "✅ All development servers stopped"
echo ""
echo "To start: ./scripts/dev-start"
