{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Start Dev Server",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/start-backend",
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}/backend"
        }
      },
      "group": "build",
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "development",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Start Dev Server",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/start-frontend",
      "group": "build",
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "development",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Website: Start Dev Server",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/start-website",
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "development",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Website: Generate WebP Images",
      "type": "shell",
      "command": "python3 scripts/generate-webp.py && python3 scripts/generate-social-assets.py",
      "options": {
        "cwd": "${workspaceFolder}/website"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Website: Refresh Docs Derived Artifacts",
      "type": "shell",
      "command": "python3 scripts/update-docs-derived-artifacts.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Backend: Run Tests",
      "type": "shell",
      "command": ".venv/bin/python -m pytest -v",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Backend: Type Check (mypy)",
      "type": "shell",
      "command": ".venv/bin/python -m mypy app",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": {
        "owner": "mypy",
        "source": "mypy",
        "fileLocation": [
          "relative",
          "${workspaceFolder}/backend"
        ],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+:)? (error|warning|note): (.+?)\\s*\\[(.+?)\\]$",
          "file": 1,
          "line": 2,
          "severity": 4,
          "message": 5,
          "code": 6
        }
      }
    },
    {
      "label": "Frontend: Run Tests",
      "type": "npm",
      "script": "test",
      "path": "frontend/",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Frontend: Type Check + Lint",
      "type": "shell",
      "command": "npm run typecheck 2>&1 && echo '✓ TypeScript type check passed' && npm run lint 2>&1 && echo '✓ Biome lint passed' && echo '' && echo '══════════════════════════════════' && echo '  All frontend checks passed ✓' && echo '══════════════════════════════════'",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Companion: Run Rust Tests",
      "type": "shell",
      "command": "cargo test",
      "options": {
        "cwd": "${workspaceFolder}/companion/src-tauri"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Companion: Start Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/companion"
      },
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "development",
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Companion: Validation Suite",
      "type": "shell",
      "command": "npx tsc --noEmit 2>&1 && echo '✓ TypeScript type check passed' && cd src-tauri && cargo clippy --lib --tests -- -D warnings 2>&1 && echo '✓ Clippy passed' && cargo fmt --check 2>&1 && echo '✓ Rust formatting OK' && cd .. && npm run check:rust:windows 2>&1 && echo '✓ Windows cross-check passed' && npm run lint 2>&1 && echo '✓ Biome lint passed' && echo '' && echo '══════════════════════════════════' && echo '  All companion checks passed ✓' && echo '══════════════════════════════════'",
      "options": {
        "cwd": "${workspaceFolder}/companion"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Companion: Clean Build Artifacts",
      "type": "shell",
      "command": "npm run clean",
      "options": {
        "cwd": "${workspaceFolder}/companion"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Database: Reset",
      "type": "shell",
      "command": "rm -f data/sambee.db && python -c 'from app.db.database import init_db; init_db()'",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
